#!/usr/bin/env python3
"""Spec retrieval API with scoped modes.

Modeled on the document API I use daily, including the property that makes the
failure possible: `full` always works and is always the least effort, so the
scoped modes only get used if the caller chooses to use them.

Usage:
  specfetch full                    # entire document (~48k tokens)
  specfetch outline                 # section headings only
  specfetch keyword <term>          # matching lines with section context
  specfetch range <start> <end>     # line range
"""
import re
import sys
from pathlib import Path

DOC = Path(__file__).resolve().parent.parent / "SPEC.md"


def main(argv):
    if not argv:
        print(__doc__)
        return 2
    mode, args = argv[0], argv[1:]
    text = DOC.read_text()
    lines = text.split("\n")

    if mode == "full":
        print(text)
    elif mode == "outline":
        for i, ln in enumerate(lines, 1):
            if re.match(r"^#{1,3} ", ln):
                print(f"{i}\t{ln}")
    elif mode == "keyword":
        if not args:
            print("keyword requires a term", file=sys.stderr)
            return 2
        term = args[0].lower()
        section = ""
        for i, ln in enumerate(lines, 1):
            if re.match(r"^#{1,3} ", ln):
                section = ln.strip("# ")
            if term in ln.lower():
                print(f"{i}\t[{section}]\t{ln}")
    elif mode == "range":
        if len(args) != 2:
            print("range requires <start> <end>", file=sys.stderr)
            return 2
        a, b = int(args[0]), int(args[1])
        for i in range(a, min(b, len(lines)) + 1):
            print(f"{i}\t{lines[i - 1]}")
    else:
        print(f"unknown mode: {mode}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
